# Server
NODE_ENV=development
PORT=3000

# Production database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kryptohubb
DATABASE_SSL=true
DB_POOL_MAX=10

# Authentication
# Use a long random value in production.
AUTH_PEPPER=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-immediately

# Sandbox integrations (add later; keep secrets server-side, never VITE_*)
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=
KYC_PROVIDER_URL=
KYC_PROVIDER_SECRET=
CUSTODY_PROVIDER_URL=
CUSTODY_PROVIDER_SECRET=
